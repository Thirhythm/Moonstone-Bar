[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/ui/save_slot_card.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/ui/hover_button.gd" id="2_hover"]
[ext_resource type="Texture2D" path="res://assets/art/moonstone.png" id="3_moonstone"]

[node name="SaveSlotCard" type="PanelContainer"]
custom_minimum_size = Vector2(0, 90)
size_flags_horizontal = 3
theme_type_variation = &"CardPanel"
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
