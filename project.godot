; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Moonstone Bar"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
config/icon="uid://b0pp6i6l7cn28"

[autoload]

SaveManager="*res://scripts/autoload/save_manager.gd"
GameData="*res://scripts/data/game_data.gd"
GameState="*res://scripts/autoload/game_state.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"
UITheme="*res://scripts/autoload/ui_theme.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=400
window/size/mode=2
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp_toolkit/plugin.cfg")

[gui]

theme/custom="res://assets/theme/base_theme.tres"

[mcp_toolkit]

server/version="latest"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
